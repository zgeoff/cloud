{
  "name": "@zgeoff/cloud",
  "private": true,
  "description": "Infrastructure as code for geoff.cloud",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/cloud.git"
  },
  "workspaces": [
    "infra",
    "packages/*",
    "sdk/*",
    "workers/*"
  ],
  "type": "module",
  "scripts": {
    "audit": "bun audit",
    "deadcode": "knip",
    "files:branch": "bun scripts/read-branch-files.ts",
    "lint": "oxlint",
    "lint:files": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:full": "oxlint --type-aware --type-check --report-unused-disable-directives-severity error",
    "test": "bun test",
    "test:health-check": "cd workers/health-check && bun test",
    "test:preview": "cd packages/preview && bun test",
    "test:files": "cd packages/files && bun test",
    "test:related": "bun scripts/run-related-tests.ts",
    "test:scripts": "bash scripts/run-shell-suites.sh",
    "test:alert-rules": "bash scripts/run-shell-suites.sh alert-rules",
    "test:atc-gateway-fixture": "bash images/atc-gateway/run-fixture-tests.sh",
    "test:nixie-backup-fixture": "bash scripts/run-shell-suites.sh nixie-backup-fixture",
    "test:files-backup-fixture": "bash scripts/run-shell-suites.sh files-backup-fixture",
    "login:ghcr": "bun scripts/login-ghcr.ts",
    "test:nixos": "bash scripts/run-nixos-checks.sh",
    "ci:write-deploy-env": "bash scripts/write-deploy-env.sh",
    "ci:check-prod-plan": "bun scripts/check-prod-plan.ts",
    "test:files-image": "bash images/files/run-image-tests.sh",
    "test:agent-image": "docker build -t cloud/agent-image images/agent && bun scripts/check-agent-image.ts --docker cloud/agent-image && bash scripts/run-shell-suites.sh agent-image",
    "typecheck": "bun run sdk:build && tsc -p tsconfig.json --noEmit && tsc -p workers/health-check/tsconfig.json --noEmit",
    "format": "oxfmt . && format-codemod --quiet .",
    "format:check": "oxfmt --check . && format-codemod --check --quiet .",
    "provider:build": "cd provider && go build -o bin/pulumi-resource-onidel ./cmd/pulumi-resource-onidel",
    "provider:check": "bash provider/check.sh",
    "onidel:snapshot": "cd provider && go run ./cmd/onidel snapshot",
    "sdk:gen": "bash scripts/gen-sdk.sh",
    "check:pulumi-pins": "bash scripts/check-pulumi-pins.sh",
    "check:image-pins": "bun scripts/check-image-pins.ts",
    "check:release-pins": "bun scripts/release/check-release-pins.ts",
    "check:restore-job": "bun infra/cluster/write-restore-jobs.ts --check",
    "write:restore-job": "bun infra/cluster/write-restore-jobs.ts",
    "write:network-policies": "bun infra/shared/write-network-policies.ts && oxfmt nixos/checks/network-policies.json",
    "check:topology": "bun scripts/check-topology.ts && bun scripts/write-exposure-table.ts --check",
    "docs:exposure": "bun scripts/write-exposure-table.ts",
    "check:sdk": "bash scripts/check-sdk.sh",
    "prepare": "command -v git > /dev/null 2>&1 && lefthook install --force || true",
    "preview": "bun run provider:build && cd infra && op run --env-file=../.env -- pulumi preview --stack prod",
    "drift": "bun run sdk:build && bun run preview --refresh --expect-no-changes",
    "up": "bun run provider:build && cd infra && op run --env-file=../.env -- pulumi up --stack prod",
    "nixie:reset": "bun scripts/reset-nixie.ts",
    "nixie:check-stream": "bun scripts/check-nixie-stream.ts",
    "nixie:check-sandbox": "bun scripts/check-nixie-fetch-sandbox.ts",
    "nixie:openapi": "bun scripts/nixie-api/write-nixie-api-contract.ts",
    "sdk:build": "tsc -p sdk/onidel/tsconfig.json && cp sdk/onidel/package.json sdk/onidel/bin/package.json",
    "lint:sh": "bash scripts/lint.sh sh",
    "lint:nix": "bash scripts/lint.sh nix",
    "lint:py": "bash scripts/lint.sh py",
    "lint:actions": "bash scripts/lint.sh actions && bun scripts/check-workflow-steps.ts",
    "check:doc-links": "bash .claude/skills/docs-writing/scripts/check-links.sh",
    "check:doc-length": "bash .claude/skills/docs-writing/scripts/check-length.sh",
    "ci:decide-prod-apply": "bash scripts/decide-prod-apply.sh",
    "ci:check-out-deployed-revision": "bash scripts/check-out-deployed-revision.sh",
    "ci:preview-and-guard-prod": "bash scripts/preview-and-guard-prod.sh",
    "ci:refresh-prod": "bash scripts/refresh-prod.sh",
    "ci:retry-transient-pulumi": "bash scripts/retry-transient-pulumi.sh",
    "ci:wait-for-k3s-api": "bash scripts/wait-for-k3s-api.sh",
    "ci:decide-prod-outcome": "bash scripts/decide-prod-outcome.sh",
    "ci:move-deployed-prod": "bash scripts/move-deployed-prod.sh",
    "ci:alert-prod-apply": "bash scripts/alert-prod-apply.sh",
    "ci:decide-nixos-checks": "bash scripts/decide-nixos-checks.sh",
    "ci:open-kvm": "bash scripts/open-kvm.sh",
    "ci:write-release-bumps": "bun scripts/release/run-write-release-bumps.ts",
    "ci:set-release-bot-identity": "bun scripts/release/run-set-release-bot-identity.ts",
    "ci:bump-releases": "bun scripts/release/run-release-bumps.ts",
    "ci:decide-release-bump-merge": "bun scripts/release/run-release-bump-merge.ts",
    "ci:decide-gates": "bun scripts/run-decide-gates.ts",
    "ci:install-pulumi-cli": "bash scripts/install-pulumi-cli.sh",
    "ci:publish-atc-gateway-images": "bash scripts/publish-atc-gateway-images.sh",
    "ci:decide-atc-gateway-publish": "bun scripts/release/run-decide-gateway-publish.ts",
    "ci:write-files-image-context": "bash scripts/write-files-image-context.sh",
    "ci:publish-files-image": "bash scripts/publish-files-image.sh",
    "ci:pin-atc-gateway-images": "bun scripts/release/run-published-images-bump.ts atc-gateway-images"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@faker-js/faker": "10.6.0",
    "@orpc/client": "1.15.6",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.3",
    "@zgeoff/bun-test-extended": "0.2.0",
    "@zgeoff/cloud-topology": "workspace:*",
    "@zgeoff/format-codemod": "0.3.0",
    "@zgeoff/oxlint-config": "0.6.1",
    "@zgeoff/skill-gate": "0.2.2",
    "knip": "6.41.0",
    "lefthook": "2.2.1",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "ts-pattern": "5.9.0",
    "tslib": "2.8.1",
    "typescript": "7.0.2",
    "typescript-5": "npm:typescript@5.9.3"
  },
  "packageManager": "bun@1.4.3"
}
