{
  "name": "@zgeoff/cloud",
  "private": true,
  "description": "Infrastructure as code for geoff.cloud",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/cloud.git"
  },
  "workspaces": [
    "infra",
    "sdk/*"
  ],
  "type": "module",
  "scripts": {
    "build:agents": "bash scripts/build-agents-md.sh agents/shared.md agents/project.md AGENTS.md",
    "audit": "bun audit",
    "deadcode": "knip",
    "lint": "oxlint --type-aware --type-check --report-unused-disable-directives-severity error",
    "lint:fix": "oxlint --type-aware --type-check --report-unused-disable-directives-severity error --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "oxfmt . && format-codemod --quiet .",
    "format:check": "oxfmt --check . && format-codemod --check --quiet .",
    "provider:build": "cd provider && go build -o bin/pulumi-resource-onidel ./cmd/pulumi-resource-onidel",
    "provider:check": "test ! -f provider/go.mod || (cd provider && test -z \"$(gofmt -l .)\" && go vet ./... && go test ./...)",
    "prepare": "command -v git > /dev/null 2>&1 && lefthook install --force || true",
    "preview": "cd infra && op run --env-file=../.env -- pulumi preview --stack prod",
    "up": "cd infra && op run --env-file=../.env -- pulumi up --stack prod"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.3.14",
    "@zgeoff/format-codemod": "0.0.8",
    "@zgeoff/oxlint-config": "0.0.6",
    "knip": "6.24.0",
    "lefthook": "2.1.10",
    "oxfmt": "0.57.0",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "0.24.0",
    "tslib": "2.8.1",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
