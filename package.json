{
  "name": "@zgeoff/cloud",
  "private": true,
  "description": "Infrastructure as code for geoff.cloud",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/cloud.git"
  },
  "workspaces": {
    "packages": [
      "infra",
      "packages/*",
      "sdk/*",
      "workers/*"
    ],
    "catalog": {
      "@impz/client": "7.7.0",
      "@impz/testing": "7.7.0",
      "bats": "1.13.0",
      "bats-assert": "2.2.4",
      "bats-support": "0.3.0"
    }
  },
  "type": "module",
  "scripts": {
    "audit": "bun audit --ignore=GHSA-3g3m-2fjr-6pw4 --ignore=GHSA-g3hv-75wg-m249",
    "deadcode": "bash scripts/run-knip.sh",
    "files:branch": "bun scripts/read-branch-files.ts",
    "lint": "oxlint",
    "lint:files": "oxlint --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint --fix",
    "lint:full": "bun run sdk:build && TSRS_FAST=1 oxlint --type-aware --type-check --report-unused-disable-directives-severity error",
    "test": "rig unit",
    "test:health-check": "cd workers/health-check && bun test --randomize",
    "test:preview": "cd packages/preview && bun test --randomize",
    "test:files": "cd packages/files && bun test --randomize",
    "test:e2e": "rig e2e",
    "test:related": "bun scripts/run-related-tests.ts",
    "test:related-root": "rig related",
    "test:scripts": "bash scripts/run-bats.sh scripts",
    "test:alert-rules": "bash scripts/run-bats.sh alert-rules",
    "test:atc-gateway-fixture": "bash images/atc-gateway/run-fixture-tests.sh",
    "test:nixie-backup-fixture": "bash scripts/run-bats.sh nixie-backup-fixture",
    "test:files-backup-fixture": "bash scripts/run-bats.sh files-backup-fixture",
    "test:nixie-config": "bash scripts/run-bats.sh nixie-config",
    "login:ghcr": "bun scripts/login-ghcr.ts",
    "test:nixos": "bash scripts/run-nixos-checks.sh",
    "ci:write-deploy-env": "bash scripts/write-deploy-env.sh",
    "ci:check-prod-plan": "bun scripts/check-prod-plan.ts",
    "test:files-image": "bash images/files/run-image-tests.sh",
    "test:pepys-image": "bash images/pepys/run-image-tests.sh",
    "check:pepys-deployment": "cd deploy/pepys && bun install --frozen-lockfile && bun run typecheck",
    "check:pepys-api-binary": "bun deploy/pepys/check-api-binary.ts",
    "test:boxxy-image": "bash images/boxxy/run-image-tests.sh",
    "test:agent-image": "docker build -t cloud/agent-image images/agent && bun scripts/check-agent-image.ts --docker cloud/agent-image && bash scripts/run-bats.sh agent-image",
    "typecheck": "bun run sdk:build && tsrs --fast -p tsconfig.json --noEmit && tsrs --fast -p workers/health-check/tsconfig.json --noEmit",
    "format": "oxfmt . && format-codemod --quiet .",
    "format:check": "oxfmt --check . && format-codemod --check --quiet .",
    "provider:build": "cd provider && go build -o bin/pulumi-resource-onidel ./cmd/pulumi-resource-onidel",
    "provider:check": "bash provider/check.sh",
    "onidel:snapshot": "cd provider && go run ./cmd/onidel snapshot",
    "sdk:gen": "bash scripts/gen-sdk.sh",
    "check:pulumi-pins": "bash scripts/check-pulumi-pins.sh",
    "check:image-pins": "bun scripts/check-image-pins.ts",
    "check:preview-bun": "bun scripts/check-preview-bun.ts",
    "check:release-pins": "bun scripts/release/check-release-pins.ts",
    "check:restore-job": "bun infra/cluster/write-restore-jobs.ts --check",
    "write:restore-job": "bun infra/cluster/write-restore-jobs.ts",
    "write:network-policies": "bun infra/shared/write-network-policies.ts && oxfmt nixos/checks/network-policies.json",
    "check:topology": "bun scripts/check-topology.ts && bun scripts/write-exposure-table.ts --check",
    "docs:exposure": "bun scripts/write-exposure-table.ts",
    "check:sdk": "bash scripts/check-sdk.sh",
    "check:onidel-vendor": "bash scripts/run-nixos-checks.sh onidel-provider-vendor",
    "prepare": "command -v git > /dev/null 2>&1 && lefthook install --force || true",
    "preview": "bun run provider:build && cd infra && op run --env-file=../.env -- pulumi preview --stack prod",
    "drift": "bun run sdk:build && bun run preview --refresh --expect-no-changes",
    "up": "bun run provider:build && cd infra && op run --env-file=../.env -- pulumi up --stack prod",
    "ops:switch-host": "bash scripts/ops.sh switch-host",
    "ops:deploy-prod": "bash scripts/ops.sh deploy-prod",
    "ops:nixos-checks": "bash scripts/ops.sh nixos-checks",
    "ops:preview": "bash scripts/ops.sh preview",
    "ops:up": "bash scripts/ops.sh up",
    "ops:switch-agent-image": "bash scripts/ops.sh switch-agent-image",
    "ops:host": "bash scripts/ops.sh host",
    "ops:cancel-prod-lock": "bash scripts/ops.sh cancel-prod-lock",
    "ops:store-nixie-verify-kubeconfig": "bash scripts/ops.sh store-nixie-verify-kubeconfig",
    "nixie:reset": "bun scripts/reset-nixie.ts",
    "nixie:check-stream": "bun scripts/check-nixie-stream.ts",
    "nixie:check-sandbox": "bun scripts/check-nixie-fetch-sandbox.ts",
    "sdk:build": "tsrs -p sdk/onidel/tsconfig.json && cp sdk/onidel/package.json sdk/onidel/bin/package.json",
    "lint:sh": "bash scripts/lint.sh sh",
    "lint:nix": "bash scripts/lint.sh nix",
    "lint:py": "bash scripts/lint.sh py",
    "lint:actions": "bash scripts/lint.sh actions && bun scripts/workflows/run-workflow-lint.ts && bun scripts/check-ci-profiles.ts",
    "ci:decide-prod-apply": "bash scripts/decide-prod-apply.sh",
    "ci:check-out-deployed-revision": "bash scripts/check-out-deployed-revision.sh",
    "ci:preview-and-guard-prod": "bash scripts/preview-and-guard-prod.sh",
    "ci:refresh-prod": "bash scripts/refresh-prod.sh",
    "ci:hold-deploy-prod-lock": "bash scripts/hold-deploy-prod-lock.sh",
    "ci:cancel-deploy-prod-update": "bash scripts/cancel-deploy-prod-update.sh",
    "ci:retry-transient-pulumi": "bash scripts/retry-transient-pulumi.sh",
    "ci:wait-for-k3s-api": "bash scripts/wait-for-k3s-api.sh",
    "ci:decide-prod-outcome": "bash scripts/decide-prod-outcome.sh",
    "ci:move-deployed-prod": "bash scripts/move-deployed-prod.sh",
    "ci:check-nixie-api": "bun scripts/run-nixie-api-check.ts",
    "ci:check-nixie-doctor": "bun scripts/run-nixie-doctor-check.ts",
    "ci:require-nixie-check": "bash scripts/require-nixie-check.sh",
    "ci:alert-prod-apply": "bash scripts/alert-prod-apply.sh",
    "ci:decide-nixos-checks": "bash scripts/decide-nixos-checks.sh",
    "ci:decide-nixos-checks-build": "bash scripts/decide-nixos-checks-build.sh",
    "ci:write-nixos-checks-cache": "bash scripts/write-nixos-checks-cache.sh",
    "ci:remove-stale-nixos-checks-caches": "bash scripts/remove-stale-nixos-checks-caches.sh",
    "ci:open-kvm": "bash scripts/open-kvm.sh",
    "ci:write-release-bumps": "bun scripts/release/run-write-release-bumps.ts",
    "ci:set-release-bot-identity": "bun scripts/release/run-set-release-bot-identity.ts",
    "ci:bump-releases": "bun scripts/release/run-release-bumps.ts",
    "ci:decide-release-bump-merge": "bun scripts/release/run-release-bump-merge.ts",
    "ci:decide-ci-gates": "bash scripts/decide-ci-gates.sh",
    "ci:check-needs": "bun scripts/check-ci-needs.ts",
    "ci:write-ci-pass-name": "bash scripts/write-ci-pass-name.sh",
    "ci:install-pulumi-cli": "bash scripts/install-pulumi-cli.sh",
    "ci:load-docker-compose": "docker compose version",
    "ci:publish-atc-gateway-images": "bash scripts/publish-atc-gateway-images.sh",
    "ci:decide-atc-gateway-publish": "bun scripts/release/run-decide-gateway-publish.ts",
    "ci:write-files-image-context": "bash scripts/write-files-image-context.sh",
    "ci:publish-files-image": "bash scripts/publish-files-image.sh",
    "ci:write-pepys-image-context": "bash scripts/write-pepys-image-context.sh",
    "ci:publish-pepys-image": "bash scripts/publish-pepys-image.sh",
    "ci:export-pepys-tool-paths": "bun scripts/pepys-image/export-tool-paths.ts",
    "ci:write-boxxy-image-context": "bash scripts/write-boxxy-image-context.sh",
    "ci:publish-boxxy-image": "bash scripts/publish-boxxy-image.sh",
    "ci:pin-atc-gateway-images": "bun scripts/release/run-published-images-bump.ts atc-gateway-images",
    "check:docs": "chex prose length links readmes skill",
    "test:images": "rig images",
    "test:fixtures": "rig fixtures"
  },
  "dependencies": {
    "@boxxy/server": "0.3.4",
    "@pepys/kit": "0.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@faker-js/faker": "10.6.0",
    "@heynixie/contract": "0.96.0",
    "@impz/client": "catalog:",
    "@impz/testing": "catalog:",
    "@mswjs/interceptors": "0.45.11",
    "@orpc/client": "1.16.2",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.4",
    "@zgeoff/agent-hooks": "0.3.2",
    "@zgeoff/bun-test-extended": "0.2.4",
    "@zgeoff/chex": "0.4.6",
    "@zgeoff/cloud-preview": "workspace:*",
    "@zgeoff/cloud-topology": "workspace:*",
    "@zgeoff/diet": "0.3.2",
    "@zgeoff/format-codemod": "0.3.6",
    "@zgeoff/oxlint-config": "0.11.3",
    "@zgeoff/rig": "0.3.2",
    "@zgeoff/std": "0.4.5",
    "@zgeoff/testing": "0.4.2",
    "bats": "catalog:",
    "bats-assert": "catalog:",
    "bats-support": "catalog:",
    "knip": "6.44.2",
    "lefthook": "2.2.2",
    "msw": "3.0.4",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "tiny-invariant": "1.3.3",
    "ts-pattern": "5.9.2",
    "tslib": "2.9.1",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  },
  "packageManager": "bun@1.4.4"
}
