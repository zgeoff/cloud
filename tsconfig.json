{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun", "@zgeoff/bun-test-extended"]
  },
  "include": [
    "infra/**/*.ts",
    "packages/**/*.ts",
    "deploy/**/*.ts",
    "*.js",
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "rig.config.ts"
  ],
  // the pepys deployment installs and type-checks on its own (deploy/pepys/package.json)
  "exclude": ["deploy/pepys/**"]
}
