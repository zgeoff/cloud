{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@zgeoff/oxlint-config/oxlintrc.json"],
  "env": {
    "node": true,
    "es2024": true
  },
  "rules": {
    // cloud's comments predate this rule of the shared config;
    // GEO-473 adopts it
    "zgeoff/max-consecutive-line-comments": "off"
  },
  "ignorePatterns": ["sdk/**", "provider/**", ".claude/**"],
  "overrides": [
    {
      "files": ["infra/**/*.ts", "workers/**/*.ts"],
      "rules": {
        "typescript/prefer-readonly-parameter-types": "off"
      }
    }
  ]
}
