{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@zgeoff/oxlint-config/oxlintrc.json"],
  "env": {
    "node": true,
    "es2024": true
  },
  "rules": {
    "zgeoff/function-verb": "error",

    // cloud's own lanes and their limit per case, as the project-testing skill lists them: the
    // NixOS VMs under KVM, the alerting engines in Docker, and the images and restore fixtures in
    // Docker; each runs Nix checks or shell suites, so the limits bind only a test file that
    // takes one of these suffixes
    "zgeoff/max-test-timeout": [
      "error",
      { "lanes": { "nixos": 1200000, "alert-rules": 90000, "images": 15000, "fixtures": 15000 } }
    ],
    "zgeoff/test-beside-module": [
      "error",
      { "lanes": { "nixos": 1200000, "alert-rules": 90000, "images": 15000, "fixtures": 15000 } }
    ],

    // the import boundaries: no relative import into another workspace package, and the direction
    // between infra's groups
    "zgeoff/import-zones": [
      "error",
      {
        "zones": {
          "any": ["**"],
          "package": ["infra/**", "packages/**", "sdk/**", "workers/**"],
          "infra": ["infra/**"],
          "infra-root": ["infra/index.ts"],
          "infra-group": ["infra/{inputs,edge,tailnet,ingress,cluster,observability}/**"],
          "infra-entry": ["infra/*/index.ts"],
          "infra-shared": ["infra/shared/**"],
          "infra-inputs": ["infra/inputs/**"],
          "infra-layer": ["infra/{edge,tailnet,ingress,cluster}/**"],
          "infra-observability": ["infra/observability/**"],
          "infra-ingress": ["infra/ingress/**"],
          "infra-test-utils": ["infra/test-utils/**"]
        },
        "extensions": [".ts", ".js", ".mjs", ".cjs", ".d.ts", ".json"],
        "edges": [
          {
            "name": "relative-import-into-another-package",
            "from": ["package"],
            "ignore": ["infra/**"],
            "to": ["any"],
            "allowWithin": "*/*",
            "reason": "reach another package through its name and exports"
          },
          {
            "name": "relative-import-into-another-package",
            "from": ["infra"],
            "to": ["any"],
            "allow": ["infra"],
            "reason": "reach another package through its name and exports"
          },
          {
            "name": "relative-import-from-the-root-package",
            "from": ["any"],
            "ignore": ["infra/**", "packages/**", "sdk/**", "workers/**"],
            "to": ["package"],
            "reason": "the root package reaches a workspace package through its name"
          },
          {
            "name": "infra-shared-imports-no-group",
            "from": ["infra-shared"],
            "to": ["infra"],
            "allow": ["infra-shared"],
            "reason": "infra/shared/ holds what several groups read"
          },
          {
            "name": "infra-inputs-imports-no-group",
            "from": ["infra-inputs"],
            "to": ["infra"],
            "allow": ["infra-inputs", "infra-shared", "infra-test-utils"],
            "reason": "inputs is the lowest group"
          },
          {
            "name": "infra-group-imports-only-lower-layers",
            "from": ["infra-layer"],
            "to": ["infra"],
            "allow": ["infra-inputs", "infra-shared", "infra-test-utils"],
            "allowWithin": "infra/*",
            "reason": "index.ts passes every value from one group to another"
          },
          {
            "name": "infra-observability-imports-only-lower-layers",
            "from": ["infra-observability"],
            "to": ["infra"],
            "allow": [
              "infra-observability",
              "infra-inputs",
              "infra-shared",
              "infra-ingress",
              "infra-test-utils"
            ],
            "reason": "observability reads ingress only for the cloudflared names"
          },
          {
            "name": "infra-cross-group-import-through-the-entry-module",
            "from": ["infra-group"],
            "to": ["infra-group"],
            "allow": ["infra-entry"],
            "allowWithin": "infra/*",
            "reason": "one group reaches another only through <group>/index.ts"
          },
          {
            "name": "infra-root-imports-only-entry-modules",
            "from": ["infra-root"],
            "to": ["infra"],
            "allow": ["infra-entry"],
            "reason": "the composition root imports each group through its entry module"
          },
          {
            "name": "infra-test-utils-only-in-tests",
            "from": ["infra"],
            "ignore": ["**/*.test.ts", "infra/test-utils/**"],
            "to": ["infra-test-utils"],
            "reason": "the Pulumi program never loads the test utils"
          }
        ],
        "unresolved": [
          {
            "name": "unresolved",
            "reason": "an import the rule cannot resolve skips every boundary above"
          }
        ]
      }
    ]
  },
  "ignorePatterns": ["sdk/**", "provider/**", ".claude/**"],
  "overrides": [
    {
      "files": ["infra/**/*.ts", "workers/**/*.ts"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "process",
            "property": "env",
            "message": "only infra/index.ts reads the env, once; take each value from loadInputs (infra/inputs/)"
          },
          {
            "object": "Bun",
            "property": "env",
            "message": "only infra/index.ts reads the env, once; take each value from loadInputs (infra/inputs/)"
          },
          {
            "object": "pulumi",
            "property": "Config",
            "message": "only infra/index.ts builds Config, once; take each value from loadInputs (infra/inputs/)"
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@pulumi/pulumi",
                "importNames": ["Config"],
                "allowTypeImports": true,
                "message": "only infra/index.ts builds Config, once; take each value from loadInputs (infra/inputs/)"
              },
              {
                "name": "@pulumi/kubernetes/core/v1",
                "importNames": ["Namespace", "NamespacePatch"],
                "allowTypeImports": true,
                "message": "declare a namespace with createNamespace or createK3sNamespacePatches (infra/shared/), which give it its Pod Security labels"
              },
              {
                "name": "@pulumi/kubernetes",
                "importNames": ["core"],
                "allowTypeImports": true,
                "message": "declare a namespace with createNamespace or createK3sNamespacePatches (infra/shared/), which give it its Pod Security labels"
              },
              {
                "name": "@pulumi/kubernetes",
                "importNames": ["Provider"],
                "allowTypeImports": true,
                "message": "take the cluster's provider from createClusterProvider (infra/cluster/), which registers the port-forward guard first"
              }
            ]
          }
        ]
      }
    },
    {
      // the two modules that declare a namespace, each through buildNamespaceMetadata
      "files": ["infra/shared/create-namespace.ts", "infra/shared/create-k3s-namespace-patches.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@pulumi/pulumi",
                "importNames": ["Config"],
                "allowTypeImports": true,
                "message": "only infra/index.ts builds Config, once; take each value from loadInputs (infra/inputs/)"
              }
            ]
          }
        ]
      }
    },
    {
      // the entry point builds Config, and declares no namespace
      "files": ["infra/index.ts"],
      "rules": {
        "no-restricted-properties": "off",
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@pulumi/kubernetes/core/v1",
                "importNames": ["Namespace", "NamespacePatch"],
                "allowTypeImports": true,
                "message": "declare a namespace with createNamespace or createK3sNamespacePatches (infra/shared/), which give it its Pod Security labels"
              },
              {
                "name": "@pulumi/kubernetes",
                "importNames": ["core"],
                "allowTypeImports": true,
                "message": "declare a namespace with createNamespace or createK3sNamespacePatches (infra/shared/), which give it its Pod Security labels"
              },
              {
                "name": "@pulumi/kubernetes",
                "importNames": ["Provider"],
                "allowTypeImports": true,
                "message": "take the cluster's provider from createClusterProvider (infra/cluster/), which registers the port-forward guard first"
              }
            ]
          }
        ]
      }
    },
    {
      // the one module that builds the cluster's provider, after it registers the port-forward guard
      "files": ["infra/cluster/create-cluster-provider.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@pulumi/pulumi",
                "importNames": ["Config"],
                "allowTypeImports": true,
                "message": "only infra/index.ts builds Config, once; take each value from loadInputs (infra/inputs/)"
              }
            ]
          }
        ]
      }
    },
    {
      // the guard's preview test hands this fixture program its case directory through the env
      "files": ["infra/test-utils/port-forward-guard-program/index.ts"],
      "rules": { "no-restricted-properties": "off" }
    }
  ]
}
