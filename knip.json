{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "infra": {
      "entry": [
        "cluster/write-restore-jobs.ts",
        "shared/write-network-policies.ts",
        "test-utils/port-forward-guard-program/index.ts"
      ],
      "project": ["**/*.ts"]
    },
    "packages/topology": {
      "entry": ["index.ts"],
      "project": ["**/*.ts"]
    },
    "packages/files": {
      "entry": ["main.ts"],
      "project": ["**/*.ts"]
    },
    "packages/preview": {
      "entry": ["main.ts"],
      "project": ["**/*.ts"]
    },
    "workers/health-check": {
      "entry": ["index.ts"],
      "project": ["**/*.ts"]
    },
    ".": {
      "entry": ["scripts/build-agent-image.ts"],
      "project": ["scripts/**/*.ts", "e2e/**/*.ts"]
    }
  },
  "ignoreDependencies": ["@stylistic/eslint-plugin", "@zgeoff/oxlint-config", "@zgeoff/skill-gate"],
  "ignoreBinaries": ["go", "gofmt", "op", "pulumi"],
  "ignore": [".claude/**"],
  "ignoreWorkspaces": ["sdk/*"]
}
