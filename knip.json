{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "infra": {
      "project": ["**/*.ts"]
    },
    "packages/topology": {
      "entry": ["index.ts"],
      "project": ["**/*.ts"]
    },
    "workers/health-check": {
      "entry": ["index.ts"],
      "project": ["**/*.ts"]
    },
    ".": {
      "project": ["scripts/**/*.ts", "e2e/**/*.ts"]
    }
  },
  "ignoreDependencies": ["@stylistic/eslint-plugin", "@zgeoff/oxlint-config"],
  "ignoreBinaries": ["go", "gofmt", "op", "pulumi"],
  "ignore": [".claude/**"],
  "ignoreWorkspaces": ["sdk/*"]
}
