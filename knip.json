{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "infra": {
      "project": ["**/*.ts"],
      "ignoreDependencies": ["@pulumi/pulumi"]
    },
    ".": {
      "entry": ["workers/*/index.ts"],
      "project": ["workers/**/*.ts"]
    }
  },
  "ignoreDependencies": ["@stylistic/eslint-plugin", "@zgeoff/oxlint-config"],
  "ignoreBinaries": ["go", "gofmt", "op", "pulumi"],
  "ignore": [".claude/**"],
  "ignoreWorkspaces": ["sdk/*"]
}
