{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "infra": {
      "entry": [
        "cluster/write-restore-jobs.ts",
        "shared/write-network-policies.ts",
        "test-utils/port-forward-guard-program/index.ts"
      ],
      "project": ["**/*.ts"]
    },
    "packages/topology": {
      "project": ["**/*.ts"]
    },
    "packages/files": {
      "entry": ["main.ts"],
      "project": ["**/*.ts"]
    },
    "packages/preview": {
      "entry": ["main.ts", "test-utils/run-stub-counting-proxy.ts"],
      "project": ["**/*.ts"]
    },
    "workers/health-check": {
      "entry": ["index.ts"],
      "project": ["**/*.ts"]
    },
    ".": {
      "entry": [
        "deploy/boxxy/server.ts",
        "scripts/build-agent-image.ts",
        "scripts/test-utils/run-stub-kubectl-proxy.ts"
      ],
      "project": ["deploy/boxxy/**/*.ts", "scripts/**/*.ts", "e2e/**/*.ts"]
    }
  },
  "ignoreDependencies": [
    "@pepys/kit",
    "@stylistic/eslint-plugin",
    "@zgeoff/agent-hooks",
    "@zgeoff/diet"
  ],
  "ignoreBinaries": ["go", "op"],
  "ignoreWorkspaces": ["sdk/*"]
}
