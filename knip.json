{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "infra": {
      "entry": ["cluster/write-restore-jobs.ts"],
      "project": ["**/*.ts"]
    },
    "packages/topology": {
      "entry": ["index.ts"],
      "project": ["**/*.ts"]
    },
    "packages/preview": {
      "entry": ["main.ts"],
      "project": ["**/*.ts"]
    },
    "workers/health-check": {
      "entry": ["index.ts"],
      "project": ["**/*.ts"]
    },
    ".": {
      "entry": ["scripts/build-agent-image.ts"],
      "project": ["scripts/**/*.ts", "e2e/**/*.ts"]
    }
  },
  "ignoreDependencies": [
    "@stylistic/eslint-plugin",
    "@swc/core",
    "@zgeoff/oxlint-config",
    "typescript-5"
  ],
  "ignoreBinaries": ["go", "gofmt", "op", "pulumi"],
  "ignore": [".claude/**"],
  "ignoreWorkspaces": ["sdk/*"]
}
