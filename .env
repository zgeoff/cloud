# Every value is an op:// reference resolved by `op run --env-file=.env -- <command>`.
# Nothing here is a secret; the items live in the 1Password `cloud` vault.

# Onidel provider
ONIDEL_API_KEY=op://cloud/onidel-api/credential

# Cloudflare provider (DNS, tunnel, Workers, R2)
CLOUDFLARE_API_TOKEN=op://cloud/cloudflare-api/credential
CLOUDFLARE_ACCOUNT_ID=op://cloud/cloudflare-api/account-id

# Pulumi state backend: R2 through its S3 API
AWS_ACCESS_KEY_ID=op://cloud/r2-pulumi-state/access-key-id
AWS_SECRET_ACCESS_KEY=op://cloud/r2-pulumi-state/secret-access-key
AWS_REGION=auto

# encrypts Pulumi stack secrets at rest
PULUMI_CONFIG_PASSPHRASE=op://cloud/pulumi-passphrase/credential

# Tailscale provider
TAILSCALE_OAUTH_CLIENT_ID=op://cloud/tailscale-oauth/client-id
TAILSCALE_OAUTH_CLIENT_SECRET=op://cloud/tailscale-oauth/client-secret
TAILSCALE_TAILNET=op://cloud/tailscale-oauth/tailnet

# Pulumi backend: the full s3:// URL for the R2 state bucket
PULUMI_BACKEND_URL=op://cloud/r2-pulumi-state/backend-url

# Discord webhook for health-check alerts (#8)
ALERT_WEBHOOK_URL=op://cloud/alert-webhook/credential
# the Discord user a critical alert mentions, so the message pushes a notification
ALERT_MENTION_USER_ID=op://cloud/alert-webhook/mention-user-id

# k3s API over the tailnet (#6)
K3S_KUBECONFIG=op://cloud/k3s-kubeconfig/kubeconfig.yaml

# 1Password Connect for imps (GEO-120): the credentials file of the Connect server
# `imp-connect`, a document item (JSON)
ONEPASSWORD_CONNECT_CREDENTIALS=op://cloud/onepassword-connect-credentials/1password-credentials.json

# k3s pulls the atc gateway's and the backup's private GHCR images with this login and classic
# read:packages token (docs/runbooks/ghcr-pull-token.md)
GHCR_PULL_USERNAME=op://cloud/ghcr-pull/username
GHCR_PULL_TOKEN=op://cloud/ghcr-pull/credential

# atc gateway only: its copy of the bearer token for geoffcloud's atc daemon. The daemon
# reads its own copy from /var/lib/atc-daemon-secrets/gateway-token on the host.
ATC_GATEWAY_TOKEN_GEOFFCLOUD=op://cloud/atc-daemon-token/credential
# The owner's PC daemon (home-pc); its copy of the token is ~/.config/atc/daemon-gateway-token
ATC_GATEWAY_TOKEN_HOME_PC=op://cloud/atc-daemon-token-home-pc/credential

# atc gateway backup (restic to its own R2 bucket). The restic repository is built from the
# endpoint and bucket: s3:<endpoint>/<bucket>/atc-gateway (infra/inputs/find-restic-backup.ts).
ATC_GATEWAY_RESTIC_PASSWORD=op://cloud/atc-gateway-restic/password
ATC_GATEWAY_R2_ACCESS_KEY_ID=op://cloud/r2-atc-gateway-backup/access-key-id
ATC_GATEWAY_R2_SECRET_ACCESS_KEY=op://cloud/r2-atc-gateway-backup/secret-access-key
ATC_GATEWAY_R2_ENDPOINT=op://cloud/r2-atc-gateway-backup/endpoint
ATC_GATEWAY_R2_BUCKET=op://cloud/r2-atc-gateway-backup/bucket

# nixie backup (restic to its own R2 bucket). The data repository is built from the endpoint and
# bucket, s3:<endpoint>/<bucket>/nixie (infra/inputs/find-restic-backup.ts), and the key repository
# sits beside it at s3:<endpoint>/<bucket>/nixie-keys, with the same R2 key and its own password.
NIXIE_RESTIC_PASSWORD=op://cloud/nixie-restic/password
NIXIE_KEY_RESTIC_PASSWORD=op://cloud/nixie-key-restic/password
NIXIE_R2_ACCESS_KEY_ID=op://cloud/r2-nixie-backup/access-key-id
NIXIE_R2_SECRET_ACCESS_KEY=op://cloud/r2-nixie-backup/secret-access-key
NIXIE_R2_ENDPOINT=op://cloud/r2-nixie-backup/endpoint
NIXIE_R2_BUCKET=op://cloud/r2-nixie-backup/bucket

# files service (GEO-1364): the role tokens, whose SHA-256 hashes the cluster holds, and its backup
# (restic to its own R2 bucket). The restic repository is built from the endpoint and bucket:
# s3:<endpoint>/<bucket>/files (infra/inputs/find-restic-backup.ts).
FILES_AGENT_TOKEN=op://cloud/files-agent-token/credential
FILES_OWNER_TOKEN=op://cloud/files-owner-token/credential
FILES_RESTIC_PASSWORD=op://cloud/files-restic/password
FILES_R2_ACCESS_KEY_ID=op://cloud/r2-files-backup/access-key-id
FILES_R2_SECRET_ACCESS_KEY=op://cloud/r2-files-backup/secret-access-key
FILES_R2_ENDPOINT=op://cloud/r2-files-backup/endpoint
FILES_R2_BUCKET=op://cloud/r2-files-backup/bucket

# nixie (GEO-343): the host's age identity, which decrypts deploy/nixie/secrets.sops.yaml in the
# pod, and git-sync's read-only deploy key for zgeoff/nixie-definitions
NIXIE_AGE_HOST_KEY=op://cloud/nixie-age-host/credential
NIXIE_DEFINITIONS_DEPLOY_KEY=op://cloud/nixie-definitions-deploy-key/credential

# pepys (docs/architecture/workloads/pepys.md): Garage's own secrets, the Garage key s2-lite writes
# the fact log with, the token s2-lite takes, and each variable that deploy/pepys/ingest-routes.json
# lists for ingest. The PEPYS_BACKUP_* and PEPYS_R2_* variables add the nightly backup: the Garage
# key the backup reads with, which an operator imports by hand (docs/runbooks/pepys-backup.md), and
# the R2 bucket it copies to.
PEPYS_GARAGE_RPC_SECRET=op://cloud/pepys-garage/rpc-secret
PEPYS_GARAGE_ADMIN_TOKEN=op://cloud/pepys-garage/admin-token
PEPYS_S2_GARAGE_ACCESS_KEY_ID=op://cloud/pepys-garage-s2/access-key-id
PEPYS_S2_GARAGE_SECRET_ACCESS_KEY=op://cloud/pepys-garage-s2/secret-access-key
PEPYS_S2_ACCESS_TOKEN=op://cloud/pepys-s2/access-token
PEPYS_GITHUB_WEBHOOK_SECRET=op://cloud/pepys-github-app/webhook-secret
PEPYS_GITHUB_APP_ID=op://cloud/pepys-github-app/app-id
PEPYS_GITHUB_APP_PRIVATE_KEY=op://cloud/pepys-github-app/private-key
PEPYS_TELEMETRY_TOKEN=op://cloud/pepys-telemetry/credential
PEPYS_BOXXY_SIGNING_SECRET=op://cloud/boxxy-pepys-signing/credential
PEPYS_BACKUP_GARAGE_ACCESS_KEY_ID=op://cloud/pepys-garage-backup/access-key-id
PEPYS_BACKUP_GARAGE_SECRET_ACCESS_KEY=op://cloud/pepys-garage-backup/secret-access-key
PEPYS_R2_ACCESS_KEY_ID=op://cloud/r2-pepys-backup/access-key-id
PEPYS_R2_SECRET_ACCESS_KEY=op://cloud/r2-pepys-backup/secret-access-key
PEPYS_R2_ENDPOINT=op://cloud/r2-pepys-backup/endpoint
PEPYS_R2_BUCKET=op://cloud/r2-pepys-backup/bucket

# boxxy server (docs/architecture/workloads/boxxy.md): the worker token, which impd's broker holds
# the second copy of, the atc service token for the gateway, the key the server signs its pepys
# facts with (pepys ingest reads the same item). The last goes with stack config boxxy.pepys. The
# notice token is an atc service token with the message scope alone, which the server sends each
# owner notice with. The BOXXY_RESTIC_* and BOXXY_R2_* variables add the nightly backup, all or
# none: they come with the r2-boxxy-backup item.
BOXXY_WORKER_TOKEN=op://cloud/boxxy-worker-token/credential
BOXXY_ATC_TOKEN=op://cloud/boxxy-atc-token/credential
BOXXY_ATC_NOTICE_TOKEN=op://cloud/boxxy-atc-notice-token/credential
BOXXY_PEPYS_SIGNING_SECRET=op://cloud/boxxy-pepys-signing/credential
# The boxxy App's keys, with which the server makes every GitHub call: they go with stack config
# boxxy.github.
BOXXY_GITHUB_APP_CLIENT_ID=op://cloud/boxxy-github-app/client-id
BOXXY_GITHUB_APP_PRIVATE_KEY=op://cloud/boxxy-github-app/private-key
BOXXY_GITHUB_APP_INSTALLATION_ID=op://cloud/boxxy-github-app/installation-id
# The noslop App's keys, with which the server posts each review: they go with stack config
# boxxy.spawn.reviewAgents.
NOSLOP_GITHUB_APP_ID=op://cloud/noslop-github-app/app-id
NOSLOP_GITHUB_APP_PRIVATE_KEY=op://cloud/noslop-github-app/private-key
NOSLOP_GITHUB_APP_INSTALLATION_ID=op://cloud/noslop-github-app/installation-id
