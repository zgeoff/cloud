# Pins for the boxxy image and its image test. scripts/check-image-pins.ts checks that each
# registry still serves its digest.

# The server's base: a glibc image with git, which the server runs to read a rules checkout. It
# runs the server as its git user, uid 65532, the uid the pod's fsGroup gives the volume.
BOXXY_BASE_IMAGE=cgr.dev/chainguard/git:latest@sha256:a79d94eecb1bc2ca2ab64e21ab2aff7a2fb0206e0e8166aed4d854c849734219

# The image test writes a rules checkout with the git-sync release that the server's pod runs, so
# the server reads the layout that git-sync makes.
GIT_SYNC_IMAGE=registry.k8s.io/git-sync/git-sync:v4.8.0@sha256:a20644562fba94773e594885cb001aadb5a3172175f13ac1215e5b2033c9200e
