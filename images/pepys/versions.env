# Pins for the cloud-pepys image: the pepys release whose host binary the image holds. The
# @pepys/* packages in deploy/pepys/package.json carry the same version, so the binary, ingest, the
# API and the consumer modules come from one release. The checksum is the asset's line in the
# release's SHA256SUMS. Change the three lines, the package versions and deploy/pepys/bun.lock in one
# commit.
PEPYS_RELEASE=v0.4.2
PEPYS_HOST_ASSET=pepys-host-linux-x64
PEPYS_HOST_ASSET_SHA256=bb7f9f9dab6f59ca051929cc76f13ea162652e89d5867a3f87745750ed680f6a
