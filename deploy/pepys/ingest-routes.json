{
  "routes": [
    {
      "source": "github",
      "route": "/webhook/github",
      "reach": "public"
    },
    {
      "source": "telemetry",
      "route": "/v1/logs",
      "reach": "private"
    },
    {
      "source": "telemetry",
      "route": "/v1/metrics",
      "reach": "private"
    },
    {
      "source": "telemetry",
      "route": "/v1/traces",
      "reach": "private"
    }
  ],
  "secretVariables": [
    "PEPYS_GITHUB_WEBHOOK_SECRET",
    "PEPYS_GITHUB_APP_ID",
    "PEPYS_GITHUB_APP_PRIVATE_KEY",
    "PEPYS_TELEMETRY_TOKEN"
  ]
}
