# Pins for the atc-gateway images. Change a pin in its own commit, then run
# scripts/test-atc-gateway-fixture.sh.

# atc release that holds the gateway binary, with atc #242 (impPrefix). The checksum is
# the asset's line in the release's SHA256SUMS. The cloud daemon runs the same release's
# atc-linux-x64.
ATC_RELEASE=@zgeoff/atc@2.24.0
ATC_ASSET=atc-gateway-linux-x64
ATC_ASSET_SHA256=9fad29613474c044a879e59eca8a9f25f2a0da5438a7557505e3d37e0b77ca9b

BASE_IMAGE=gcr.io/distroless/cc-debian12:nonroot@sha256:9dac0a79194e45a7da0158a9c6da57b217585af0786db3845d1f0ec1a0dd182f
RESTIC_IMAGE=restic/restic:0.18.1@sha256:39d9072fb5651c80d75c7a811612eb60b4c06b32ffe87c2e9f3c7222e1797e76
